# Public browser configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-your-anon-key
# Server-only allowlist read by src/lib/admin.ts. Never expose it to browsers.
ADMIN_USER_IDS=comma-separated-admin-user-uuids
# Server-only key used by Content Studio routes to access private Storage and RPCs.
# Obtain it from the Supabase project settings; never expose or commit a real key.
SUPABASE_SERVICE_ROLE_KEY=replace-with-your-service-role-key

# Server-only Content Studio control-plane secret. Generate a long random value.
# It must exactly match the `machine` entry in the Mac's `quobby-content-studio`
# Keychain service. Never prefix it with NEXT_PUBLIC_ or commit a real value.
CONTENT_STUDIO_MACHINE_TOKEN=replace-with-a-long-random-token
# Optional. Vercel Cron sends this as `Authorization: Bearer $CRON_SECRET`;
# set it to the same value as CONTENT_STUDIO_MACHINE_TOKEN to top up the funny
# clip library automatically. See /api/internal/content-studio/curate.
CRON_SECRET=

# Server-only keys for Content Studio "Generate meme". Set one stock key
# (Pixabay is used when both are set): https://pixabay.com/api/docs/ or
# https://www.pexels.com/api/ . Gemini: https://aistudio.google.com/apikey
PIXABAY_API_KEY=
PEXELS_API_KEY=
GEMINI_API_KEY=
# Optional; defaults to gemini-3.5-flash-lite, which falls back to
# gemini-3.1-flash-lite automatically while a model is overloaded.
GEMINI_MODEL=
# Optional; voice-over templates use Gemini TTS. Defaults to gemini-3.8-flash-tts.
GEMINI_TTS_MODEL=

# Optional server integration
BGG_API_TOKEN=
